{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connections",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "badtengu.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
